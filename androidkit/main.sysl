// androidkit — a sysl program on Android, and the smallest one that shows anything.
//
// **The interesting thing about this program is the name of its one function.** Android has no
// `main`: `SDLActivity` loads `libmain.so` and looks up the symbol `SDL_main` in it, so what an
// Android program needs is not an entry point that runs first but one the Java half can find — and
// `@export` publishes exactly that (`15 §12`).
//
// **So there is no C in this repository at all.** Every other SDL project carries a shim,
// `int SDL_main(int argc, char **argv) { return main(argc, argv); }`, because a C program's entry
// point is called `main` and SDL wants a different name. sysl defines the symbol directly, and the
// shim has nothing left to do.
//
// Everything else here is what a phone makes you think about that a desktop does not, and each line
// of it is one this program got wrong first. Copy the repository and write over this file.

import sh.sysl.sdl3.*
import sh.sysl.sdl3_ttf.*
import sh.sysl.sdl3.{INIT_VIDEO, SCANCODE_ESCAPE, WINDOW_RESIZABLE}
import sh.sysl.sdl3.c.FRect
import sysl.fs.is_file

// **What the window is asked for, and not what it gets.** Android answers a size request with the
// screen, so these two matter only on a desktop — where the same source runs unchanged under
// `sysl run`. They also decide which way up an Android app starts: SDL reads the requested shape,
// and wider-than-tall turns a phone sideways.
const WANTED_W: i32 = 800
const WANTED_H: i32 = 600

// How tall the message is drawn, in pixels. A real outline font, so this is a size rather than a
// magnification and the glyphs are rasterized at it.
const POINTS: f32 = 64.0

const MESSAGE: string = "hello from sysl"

// **A font the device already has, rather than one this repository ships.** Android keeps its system
// faces in `/system/fonts`, so a program that wants ordinary text needs no asset, no packaging step
// and nothing in the APK — the same trick `sdl3-demo` uses on a desktop. The list is tried in order
// because which faces are present varies by vendor and by version, and the last two are what a
// desktop has, so this function is also what makes the program run under `sysl run`.
font_path() -> string
    val candidates = [
        "/system/fonts/Roboto-Regular.ttf",
        "/system/fonts/DroidSans.ttf",
        "/system/fonts/NotoSans-Regular.ttf",
        "/System/Library/Fonts/Supplemental/Arial.ttf",
        "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
    ]

    for i in 0..<candidates.len
        if is_file(candidates[i]) then return candidates[i]

    ""
end font_path

// ## Where the system bars are
//
// **`window.safe_area()` is the obvious answer and it is the wrong rectangle for a drawing.** SDL
// builds Android's safe area out of five inset types at once — `systemBars`, `systemGestures`,
// `mandatorySystemGestures`, `tappableElement` and `displayCutout` — because it answers *where can a
// button go*. On a gesture-navigation phone that is 78 pixels off each side for the back-gesture
// strips and a bottom inset reaching above the navigation bar. For something only being looked at,
// all of that is too conservative.
//
// What a drawing wants is the window minus the **system bars** and nothing else, and SDL exposes only
// the combined rectangle — so `MainActivity` reads `WindowInsets.Type.systemBars()` and hands the
// four over through the JNI entry point below.
//
// **They are written on the UI thread and read on SDL's**, which is deliberate rather than
// overlooked: four independent `i32` stores are the one shape where a lock buys nothing worth having.
var bar_left: i32 = 0
var bar_top: i32 = 0
var bar_right: i32 = 0
var bar_bottom: i32 = 0

// **A JNI entry point, defined in sysl.** JNI resolves an `external fun` by mangling its package and
// class into `Java_<package>_<Class>_<method>`, so this string is what `MainActivity`'s
// `nativeSetSystemBars` binds to. A rename on either side still links — JNI resolves at run time —
// and fails at the first call. (`self` is a reserved word, hence `instance`.)
//
// **Module storage beside an `@export` in one file needs sysl newer than 0.0.62.** Before that the
// file was read as the program's beginning even though `build-c` emits none, so its functions became
// nested functions of a body nothing emits — which renamed them and dropped every `@export` in the
// file, silently. Card `0167`.
@export("Java_sh_sysl_androidkit_MainActivity_nativeSetSystemBars")
set_system_bars(env: *u8, instance: *u8, l: i32, t: i32, r: i32, b: i32)
    bar_left = l
    bar_top = t
    bar_right = r
    bar_bottom = b
end set_system_bars

@export("SDL_main")
sdl_main(argc: i32, argv: **u8) -> i32
    // **Set before `init`, because a hint is read when the thing it configures is created** — and on
    // Android the activity's orientation is decided during startup.
    //
    // **This hint alone is not enough.** `SDLActivity.setOrientationBis` only promotes "both
    // allowed" to *follow the device* when the window is **resizable**; for a fixed window it still
    // chooses from the requested width and height, so 800x600 comes up landscape with every
    // orientation named. The two together are what make the activity `FULL_USER`.
    set_hint("SDL_ORIENTATIONS", "Portrait PortraitUpsideDown LandscapeLeft LandscapeRight")

    if !init(INIT_VIDEO)
        return 1

    if !ttf_init()
        return 1

    val path = font_path()

    if path == ""
        return 1

    val window = create_window("androidkit", WANTED_W, WANTED_H, WINDOW_RESIZABLE).expect("a window")
    val renderer = window.create_renderer().expect("a renderer")

    renderer.set_vsync(true)

    // **Rasterized once, not every frame.** Turning a string into pixels is a glyph raster and a
    // texture upload; doing it sixty times a second to draw the same words is the mistake this
    // binding makes easy. The texture is what the frame loop draws.
    val font = open_font(path, POINTS).expect("the font opened")
    val label = font.texture(renderer, MESSAGE, rgb(220, 220, 230)).expect("the message rendered")
    val (tw, th) = label.size()

    var running = true

    while running
        loop
            poll_event() match
                Some(e) ->
                    if e.kind() == EventKind.Quit then running = false
                    elif e.kind() == EventKind.KeyDown && e.key_scancode() == SCANCODE_ESCAPE
                        running = false
                None -> break

        // **Asked every frame rather than once.** On a high-density display the drawable size is
        // larger than the window's logical size; on Android it is the screen, and both it and the
        // insets change when the phone is turned.
        val (pw, ph) = renderer.output_size()
        val left = f32(bar_left)
        val top = f32(bar_top)
        val right = f32(pw - bar_right)
        val bottom = f32(ph - bar_bottom)

        renderer.clear_to(rgb(18, 18, 22))

        // **Centred against the bars, not against the screen.** The measurements come from the
        // texture rather than from the string, which is what a real outline face makes necessary —
        // glyphs are not one width, so there is nothing to multiply. `label.size()` was asked once,
        // above, because the answer only changes when the message does.
        //
        // For a fixed 8x8 bitmap font needing no font file at all, `renderer.debug_text` draws in one
        // SDL carries inside itself. It is a debugging face by SDL's own description — one size, one
        // face, ASCII — and enough for a frame counter, which is why this program uses `sdl3-ttf`
        // instead.
        renderer.copy_to(label, FRect((left + right - tw) * 0.5, (top + bottom - th) * 0.5, tw, th))
        renderer.present()

    quit()
    0
end sdl_main
