// androidkit — sysl on Android, drawn by SDL3.
//
// **The whole program is one function, and the interesting thing about it is its name.** Android has
// no `main`. `SDLActivity` loads `libmain.so` and looks up the symbol `SDL_main` in it, so what an
// Android program needs is not an entry point that runs first but one the Java half can find — and
// `@export` publishes exactly that (`15 §12`).
//
// **That is why there is no C in this repository at all.** Every other SDL project carries a shim,
// `int SDL_main(int argc, char **argv) { return main(argc, argv); }`, because a C program's entry
// point is called `main` and SDL wants a different name. sysl can define the symbol directly, so the
// shim has nothing left to do.
//
// Everything below is an ordinary SDL program — create a window, drain the events, draw, present —
// and none of it knows it is on a phone. The same source runs on a desktop with `sysl run`.

import sh.sysl.sdl3.*
import sh.sysl.sdl3.c.{INIT_VIDEO, SCANCODE_ESCAPE, WINDOW_RESIZABLE}

// **What the window is asked for, and not what it gets.** Android answers a size request with the
// screen, so these two numbers matter only on a desktop; the size the program actually draws to is
// read back inside the loop. A program that skipped that would draw in one corner of a phone.
//
// **They also decide which way up an Android app starts, which is not obvious.** SDL picks the
// activity's orientation from the shape of the window it is asked for — wider than tall means
// landscape — so a desktop-shaped request turns a phone sideways. The hint below is what stops that
// being decided by two numbers meant for a desktop.
const WANTED_W: i32 = 800
const WANTED_H: i32 = 600

// One square, bouncing, in pixels per second — a speed in seconds rather than in frames, which is
// what makes it the same on a 60 Hz phone and a 120 Hz one.
const SIDE: f32 = 140.0
const SPEED: f32 = 320.0

@export("SDL_main")
sdl_main(argc: i32, argv: **u8) -> i32
    // **Set before `init`, because a hint is read when the thing it configures is created** — and on
    // Android the activity's orientation is decided during startup.
    //
    // **This hint alone is not enough, and the reason is worth knowing.** `SDLActivity`'s
    // `setOrientationBis` only promotes "both allowed" to *follow the device* when the window is
    // **resizable**; for a fixed window it still chooses from the requested width and height, so
    // 800x600 comes up landscape with every orientation named. That is why `WINDOW_RESIZABLE` is
    // below and not decoration: the two together are what make the activity `FULL_USER`. Read out of
    // `SDLActivity.java` after this demo came up sideways on a portrait phone twice.
    set_hint("SDL_ORIENTATIONS", "Portrait PortraitUpsideDown LandscapeLeft LandscapeRight")

    if !init(INIT_VIDEO)
        return 1

    // **`WINDOW_RESIZABLE` is what lets the device decide which way up this is** — see the hint
    // above. It is also honest about what the program does: the loop reads the drawable size every
    // frame, so a window that changes shape underneath it is a case that is already handled.
    val window = create_window("androidkit", WANTED_W, WANTED_H, WINDOW_RESIZABLE).expect("a window")
    val renderer = window.create_renderer().expect("a renderer")

    // Pace on the display's refresh. The step is measured either way, so a device that ignores this
    // still runs at the right speed — it just runs hot, which on a phone is a battery rather than a
    // fan.
    renderer.set_vsync(true)

    // Started at the window's origin and corrected into the safe area by the first frame's bounce
    // check, which is one line cheaper than asking for the rectangle twice.
    var x: f32 = 0.0
    var y: f32 = 0.0
    var dx = SPEED
    var dy = SPEED
    var last = ticks()
    var running = true

    while running
        // **Where it is safe to draw, asked every frame rather than once.**
        //
        // From API 35 an Android app draws edge to edge whether it asks to or not — there is no
        // opting out by targeting lower — so the window runs *under* the status bar at the top and
        // the gesture bar at the bottom. A program that bounced against the window's own size would
        // send the square behind both of them, correctly drawn and invisible, which is what this
        // demo did before it asked. `safe_area` is the rectangle with those subtracted.
        //
        // Asked per frame because it changes: turning the phone moves the bars, and so does anything
        // that shows or hides one. One SDL call a frame is nothing, and caching it is how a program
        // ends up bouncing off where the wall used to be.
        //
        // **The other answer is `window.set_fullscreen(true)`, which hides the bars and hands the
        // program the glass** — right for a game, and it makes the safe area the whole window, so
        // nothing below would have to change. This demo keeps them so that the rectangle is doing
        // visible work.
        val safe = window.safe_area()
        val left = f32(safe.x)
        val top = f32(safe.y)
        val right = f32(safe.x + safe.w)
        val bottom = f32(safe.y + safe.h)

        // **Every pending event is drained before anything is drawn.** A loop that took one event
        // per frame would fall behind a finger moving across the glass, which is the input device
        // this program is most likely to meet.
        loop
            poll_event() match
                Some(e) ->
                    if e.kind() == EventKind.Quit then running = false
                    elif e.kind() == EventKind.KeyDown && e.key_scancode() == SCANCODE_ESCAPE
                        running = false
                None -> break

        // The step is the time the last frame actually took, clamped: an app sent to the background
        // stops the loop for as long as it is away, and an unclamped step would then teleport the
        // square through a wall on the way back.
        val now = ticks()
        var dt = f32(now - last) / 1000.0

        if dt > 0.1 then dt = 0.1
        last = now

        x += dx * dt
        y += dy * dt

        if x < left
            x = left
            dx = -dx
        elif x + SIDE > right
            x = right - SIDE
            dx = -dx

        if y < top
            y = top
            dy = -dy
        elif y + SIDE > bottom
            y = bottom - SIDE
            dy = -dy

        renderer.clear_to(rgb(18, 18, 22))
        renderer.set_draw_color(rgb(120, 200, 255))
        renderer.fill_rect(x, y, SIDE, SIDE)
        renderer.present()

    // The window and the renderer both carry `Drop`, so there is nothing to close by hand — which
    // leaves `quit` as the one teardown call this program makes.
    quit()
    0
end sdl_main
